<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>大明国策 v3.2</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#8b2c1a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="大明国策">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='80' font-size='80'%3E%F0%9F%9A%9C%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="game-container">
    <!-- 顶部 -->
    <header class="dynasty-header">
        <div class="dynasty-title">
            <span class="era-name" id="era-name">成化十年</span>
            <span class="emperor" id="emperor">春 · 孟月</span>
        </div>
        <div class="time-control">
            <span class="time-label" id="time-label">决事 0 次</span>
            <button class="time-btn" id="next-month">下季 ▶</button>
            <button class="time-btn" id="next-year" title="快进一年">快1年 ▶▶</button>
            <button class="save-btn" id="sfx-btn" title="音效设置">音</button>
            <button class="save-btn" id="save-btn" title="手动存档">存</button>
        </div>
    </header>

    <!-- 左侧：系统菜单 -->
    <nav class="system-menu">
        <h2 class="menu-title">朝廷六部</h2>
        <div class="menu-tabs" id="menu-tabs">
            <div class="menu-tab active" data-tab="overview">览</div>
            <div class="menu-tab" data-tab="politics">政</div>
            <div class="menu-tab" data-tab="govern">改</div>
            <div class="menu-tab" data-tab="economy">财</div>
            <div class="menu-tab" data-tab="personnel">人</div>
            <div class="menu-tab" data-tab="impeach">刑</div>
            <div class="menu-tab" data-tab="construction">工</div>
            <div class="menu-tab" data-tab="diplomacy">礼</div>
            <div class="menu-tab" data-tab="finance">赋</div>
            <div class="menu-tab" data-tab="military">兵</div>
            <div class="menu-tab" data-tab="transport">水</div>
            <div class="menu-tab" data-tab="prison">囹</div>
            <div class="menu-tab" data-tab="harem">宫</div>
            <div class="menu-tab" data-tab="court">朝</div>
            <div class="menu-tab" data-tab="keju">科</div>
            <div class="menu-tab" data-tab="yingzao">造</div>
            <div class="menu-tab" data-tab="tech">气</div>
            <div class="menu-tab" data-tab="decade">年</div>
            <div class="menu-tab" data-tab="yearend">岁</div>
            <div class="menu-tab" data-tab="map">图</div>
            <div class="menu-tab" data-tab="markets">市</div>
            <div class="menu-tab" data-tab="censor">宪</div>
            <div class="menu-tab" data-tab="secret">卫</div>
            <div class="menu-tab" data-tab="intrigue">权</div>
            <div class="menu-tab" data-tab="prince">藩</div>
            <div class="menu-tab" data-tab="selection">铨</div>
            <div class="menu-tab" data-tab="tribute">贡</div>
            <div class="menu-tab" data-tab="famine">荒</div>
            <div class="menu-tab" data-tab="emperor">帝</div>
            <div class="menu-tab" data-tab="share">分</div>
            <div class="menu-tab" data-tab="compare">比</div>
            <!-- 批E：王朝使命 -->
            <div class="menu-tab" data-tab="mission">命</div>
        </div>
    </nav>

    <!-- 主内容 -->
    <main class="main-content">
        <!-- 左侧：22资源 + 5派系 -->
        <aside class="left-panel">
            <h2 class="panel-title">国运资储</h2>
            <div class="stat-list" id="resource-list"></div>
            <h2 class="panel-title" style="margin-top:24px">朝堂势力</h2>
            <div class="faction-list" id="faction-list"></div>
        </aside>

        <!-- 中央：国事区（永久DOM，切tab不销毁） -->
        <div class="edict-zone" id="edict-zone">
            <div class="season-banner" id="season-banner"></div>
            <div class="edict-paper" id="edict-paper">
                <div class="edict-from" id="edict-from">【候旨】</div>
                <h2 class="edict-title" id="edict-title">国事待理</h2>
                <div class="edict-content" id="edict-content">点右上"下季"推进国事，遇有大事将有急奏呈上。</div>
            </div>
        </div>
        <!-- 中央：当前面板 -->
        <section class="center-panel" id="center-panel">
            <!-- 中央内容由各系统动态渲染 -->
        </section>
        <!-- 中央：已决政事（永久DOM） -->
        <div class="edict-history" id="edict-history-zone">
            <h3 class="history-title">已决政事</h3>
            <div class="history-list" id="history-list"></div>
        </div>

        <!-- 右侧：天象 + 朝报 + 稳定度 -->
        <aside class="right-panel">
            <h2 class="panel-title">天象警兆</h2>
            <div class="celestial">
                <div class="celestial-item">
                    <span class="celestial-label">日食</span>
                    <span class="celestial-value" id="omen-eclipse">未现</span>
                </div>
                <div class="celestial-item">
                    <span class="celestial-label">彗星</span>
                    <span class="celestial-value" id="omen-comet">未现</span>
                </div>
                <div class="celestial-item">
                    <span class="celestial-label">天命</span>
                    <span class="celestial-value" id="omen-mandate">安宁</span>
                </div>
            </div>
            <h2 class="panel-title" style="margin-top:24px">朝报密闻</h2>
            <div class="news-list" id="news-list"></div>
            <h2 class="panel-title" style="margin-top:24px">社稷稳定度</h2>
            <div class="stability-box">
                <div class="stability-level" id="stability-level">正常</div>
                <div class="stability-bar">
                    <div class="stability-fill" id="stability-fill"></div>
                </div>
            </div>
        </aside>
    </main>
</div>

<!-- 批1：移动端底部导航（<768px 由 CSS 启用） -->
<nav class="mobile-tabbar" id="mobile-tabbar">
    <div class="mobile-tab active" data-mview="center"><span class="mt-icon">事</span><span class="mt-label">国事</span></div>
    <div class="mobile-tab" data-mview="left"><span class="mt-icon">储</span><span class="mt-label">资储</span></div>
    <div class="mobile-tab" data-mview="menu"><span class="mt-icon">朝</span><span class="mt-label">朝堂</span></div>
    <div class="mobile-tab" data-mview="right"><span class="mt-icon">天</span><span class="mt-label">天象</span></div>
</nav>
<button class="mobile-next-btn" id="mobile-next" title="下季">下季 ▶</button>

<!-- 事件弹窗 -->
<div class="event-modal" id="event-modal">
    <div class="event-paper">
        <div class="event-header" id="event-header">春 · 孟月</div>
        <h2 class="event-title" id="event-title">飞蝗蔽天</h2>
        <div class="event-content" id="event-content">北直隶蝗灾。</div>
        <div class="event-choices" id="event-choices"></div>
    </div>
</div>

<!-- 奏折弹窗（仪式化） -->
<div class="memorial-modal" id="memorial-modal">
    <div class="memorial-paper">
        <!-- 奏折头部：递折部门 + 密级 -->
        <div class="memorial-ribbon">
            <div class="memorial-ministry" id="memorial-ministry">户部 · 本章</div>
            <div class="memorial-time" id="memorial-time">天启三年 春</div>
        </div>
        
        <!-- 奏折主文 -->
        <div class="memorial-body">
            <div class="memorial-handle"></div>
            <h2 class="memorial-title" id="memorial-title">请发内帑赈济</h2>
            <div class="memorial-content" id="memorial-content"></div>
        </div>
        
        <!-- 票拟：内阁意见 -->
        <div class="pini-section">
            <div class="pini-label">【内阁票拟】</div>
            <div class="pini-text" id="pini-text">准奏照办</div>
            <div class="pini-reason" id="pini-reason">该部所奏合于大体，臣等议如所请。</div>
        </div>
        
        <!-- 批红：御玺 -->
        <div class="pihong-section">
            <div class="seal-container">
                <div class="seal-circle">
                    <span class="seal-glyph">御</span>
                </div>
                <div class="seal-info">
                    <div class="seal-name" id="seal-name">用制诰之宝</div>
                    <div class="seal-desc" id="seal-desc">朱文方印</div>
                </div>
            </div>
        </div>
        
        <!-- 圣裁 -->
        <h3 class="memorial-decision-title">圣上亲裁</h3>
        <div class="memorial-choices" id="memorial-choices"></div>
    </div>
</div>

<!-- 剧本选择弹窗 -->
<div class="script-modal active" id="script-modal">
    <div class="script-paper">
        <div class="script-title">大明国策</div>
        <div class="script-subtitle">天子守国门，君王死社稷</div>
        <div class="script-warning">
            ⚠ 此非爽游。<br>
            60+ 系统 × 20+ 形态 = 1200+ 数据点<br>
            22 资源 / 5 派系 / 30 大臣 / 20 后妃 / 30 科技 / 20 奇观<br>
            支持自动存档与读档，可随时刷新继续
        </div>
        <h3 style="color: #b8893a; margin-top: 30px;">请择朝代</h3>
        <div class="script-list" id="script-list"></div>
    </div>
</div>

<!-- 结局弹窗 -->
<div class="end-modal" id="end-modal">
    <div class="end-paper">
        <div class="end-era" id="end-era">天启三年</div>
        <h2 class="end-title" id="end-title">国运终焉</h2>
        <div class="end-content" id="end-content"></div>
        <div class="end-stats" id="end-stats"></div>
        <!-- 批3：结局回响「身后名」区块（编年大事/厂卫卷宗/谥号/史官总评） -->
        <div class="end-legacy" id="end-legacy"></div>
        <div class="end-buttons">
            <button class="restart-btn" id="restart-btn">再起一朝</button>
            <button class="continue-btn" id="end-continue-btn">载入存档</button>
        </div>
    </div>
</div>

<!-- 批1：岁末大计面板（五步分展 + 玉玺钦此） -->
<div class="yearend-modal" id="yearend-modal">
    <div class="yearend-paper">
        <div class="ye-header">
            <div class="ye-era" id="ye-era">岁末大计</div>
            <button class="ye-close" id="ye-close-btn">暂离</button>
        </div>
        <div class="ye-steps-bar" id="ye-steps-bar"></div>
        <div class="ye-body" id="ye-body"></div>
        <div class="ye-footer" id="ye-footer"></div>
    </div>
</div>

<!-- 批1：音效设置弹窗 -->
<div class="sfx-modal" id="sfx-modal">
    <div class="sfx-paper">
        <h2 class="sfx-title">御用音律</h2>
        <div class="sfx-row">
            <span class="sfx-label">音效</span>
            <button class="sfx-toggle" id="sfx-toggle">开</button>
        </div>
        <div class="sfx-row">
            <span class="sfx-label">音量</span>
            <input type="range" id="sfx-volume" class="sfx-volume" min="0" max="100" value="60">
        </div>
        <div class="sfx-hint">钟鼓磬音，皆宫中所制，不假外物。</div>
        <button class="sfx-close" id="sfx-close">知 道 了</button>
    </div>
</div>

<!-- 批2：舆图地区况卡浮层 -->
<div class="map-modal" id="map-modal">
    <div class="map-paper">
        <div class="map-cell-head">
            <span class="map-cell-name" id="map-cell-name">北直隶</span>
            <span class="map-cell-tag" id="map-cell-tag">布政司</span>
            <button class="map-cell-close" id="map-cell-close" onclick="closeMapModal()">退 出</button>
        </div>
        <div class="map-cell-status" id="map-cell-status">当前状态：安定</div>
        <div class="map-cell-desc" id="map-cell-desc"></div>
        <div class="map-cell-cool" id="map-cell-cool"></div>
        <div class="map-cell-actions" id="map-cell-actions"></div>
    </div>
</div>

<!-- 批3：命将出师浮层（选帅/调饷/兵力/战报急奏） -->
<div class="map-modal" id="exp-modal">
    <div class="map-paper exp-paper">
        <div class="map-cell-head">
            <span class="map-cell-name" id="exp-title">命将出师</span>
            <span class="map-cell-tag">九边战守</span>
            <button class="map-cell-close" id="exp-close" onclick="closeExpModal()">退 出</button>
        </div>
        <div class="map-cell-cool" id="exp-subtitle"></div>
        <div class="exp-body" id="exp-body"></div>
    </div>
</div>

<!-- 批C：战棋/回合制战场浮层（布阵/战术/地形/士气/火器/撤军，复用 exp-modal 样式） -->
<div class="map-modal" id="bf-modal">
    <div class="map-paper exp-paper">
        <div class="map-cell-head">
            <span class="map-cell-name" id="bf-title">战阵相持</span>
            <span class="map-cell-tag" id="bf-tag">回合制小战</span>
            <button class="map-cell-close" id="bf-close" onclick="bfClose()">退 出</button>
        </div>
        <div class="map-cell-cool" id="bf-subtitle"></div>
        <div class="exp-body" id="bf-body"></div>
    </div>
</div>

<!-- 批2：大臣召见浮层 -->
<div class="talk-modal" id="talk-modal">
    <div class="talk-paper">
        <div class="talk-head">
            <div class="talk-head-id">
                <div class="talk-name" id="talk-name"></div>
                <div class="talk-rank" id="talk-rank"></div>
            </div>
            <div class="talk-loyalty" id="talk-loyalty"></div>
            <button class="talk-close" id="talk-close" onclick="closeTalkModal()">退 下</button>
        </div>
        <div class="talk-relation" id="talk-relation"></div>
        <div class="talk-body" id="talk-body"></div>
        <div class="talk-hint" id="talk-hint"></div>
        <div class="talk-actions" id="talk-actions"></div>
    </div>
</div>

<!-- 批4：早朝议政浮层 -->
<div class="cw-modal" id="court-modal">
    <div class="cw-modal-paper" id="court-paper">
        <h3 class="cw-modal-title">早朝议政</h3>
        <div class="cw-modal-body" id="court-body"></div>
        <button class="cw-btn cw-modal-close" onclick="closeCourtModal()">退朝</button>
    </div>
</div>
<!-- 批4：科举浮层 -->
<div class="cw-modal" id="keju-modal">
    <div class="cw-modal-paper" id="keju-paper">
        <h3 class="cw-modal-title">开科取士</h3>
        <div class="cw-modal-body" id="keju-body"></div>
        <button class="cw-btn cw-modal-close" onclick="closeKejuModal()">退场</button>
    </div>
</div>
<!-- 系统弹窗（弹劾/科技/军事/后宫等） -->
<div class="system-modal" id="system-modal">
    <div class="system-paper" id="system-paper">
        <!-- 动态渲染 -->
    </div>
</div>
<!-- 批D：权谋裁决浮层（朋党倾轧/阴谋暴露/廷杖流放贬谪） -->
<div class="cw-modal" id="intrigue-modal">
    <div class="cw-modal-paper" id="intrigue-paper">
        <h3 class="cw-modal-title" id="intrigue-title">权谋裁决</h3>
        <div class="cw-modal-body" id="intrigue-desc"></div>
        <div class="cw-modal-src cw-dim" id="intrigue-src"></div>
        <div class="cw-modal-body" id="intrigue-opts"></div>
        <button class="cw-btn cw-modal-close" onclick="closeIntrigueModal()">暂缓</button>
    </div>
</div>

<script src="data/script.js"></script>
<script src="data/systems.js"></script>
<script src="data/achievements.js"></script>
<script src="data/historian.js"></script>
<script src="data/advice.js"></script>
<script src="data/memorials.js"></script>
<script src="data/memorials_v31.js"></script>
<script src="data/systems2.js"></script>
<script src="data/v31_extra.js"></script>
<script src="data/share.js"></script>
<script src="data/compare.js"></script>
<script src="data/extras_ui.js"></script>
<script src="data/extras2.js"></script>
<script src="modules.js"></script>
<script src="overview.js"></script>
<script src="sfx.js"></script>
<script src="yearend.js"></script>
<script src="mobileui.js"></script>
<script src="script.js"></script>
<!-- 批2：舆图 + 召见（置于主入口之后、DOMContentLoaded 触发前完成加载） -->
<script src="map.js"></script>
<script src="daming_talk.js"></script>
<!-- 批3：厂卫内帑 + 辽东出征（置于主入口之后、DOMContentLoaded 触发前完成加载） -->
<script src="cangwei.js"></script>
<script src="expedition.js"></script>
<!-- 批4：大幅扩容模块 -->
<script src="data/events_ext.js"></script>
<script src="data/memorials_ext.js"></script>
<script src="data/advice_ext.js"></script>
<script src="court_session.js"></script>
<script src="harem_interact.js"></script>
<script src="diplomacy_interact.js"></script>
<script src="keju.js"></script>
<script src="yingzao.js"></script>
<!-- 批5·纵深扩展 -->
<script src="military_ops_ext.js"></script>
<script src="junpi.js"></script>
<script src="zaiyi.js"></script>
<script src="lizhi.js"></script>
<script src="auto.js"></script>
<script src="batch5_bridge.js"></script>
<script src="data/achievements_ext.js"></script>
<!-- 批A：经济深改（物价/常平/开中/市舶/贪腐侵蚀/景气指数） -->
<script src="economy_market.js"></script>
<script src="govern.js"></script>
<!-- 批B：主线叙事（山河志，四剧本专属主线链+关键节点+专属结局） -->
<script src="mainline.js"></script>
<script src="battlefield.js"></script>
<!-- 批C(v6.0)：军事战守扩充（新兵种/边患战/粮道兵源/军功） -->
<script src="military_war_def.js"></script>
<!-- 批F(v6.1)：军事科技树深挖（三线研造/战法/新兵种） -->
<script src="military_tech_ext.js"></script>
<!-- 批D：界面/立绘升级（收官） -->
<script src="v5d_ui.js"></script>
<!-- 批D：权谋系统（结党/朋党倾轧/阴谋暴露/廷杖流放贬谪） -->
<script src="intrigue.js"></script>
<script src="missions.js"></script>

<script>
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js').catch(err => console.log('SW err:', err));
    });
}
</script>

<!-- 批D：王朝开场白淡入 -->
<div class="dynasty-open" id="dynasty-open"></div>
</body>
</html>
